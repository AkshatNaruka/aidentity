{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aidentity.dev/manifest.schema.json",
  "title": "Aidentity installed manifest",
  "type": "object",
  "required": ["version", "updated_at", "items"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "updated_at": { "type": ["string", "null"] },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "agent", "path", "content_hash", "installed_at"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "kind": { "type": "string", "enum": ["skill", "rule", "agent", "command", "hook"] },
          "agent": { "type": "string" },
          "path": { "type": "string" },
          "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "source_repo": { "type": "string" },
          "source_license": { "type": "string" },
          "installed_at": { "type": "string" },
          "via": { "type": "string" }
        }
      }
    }
  }
}
