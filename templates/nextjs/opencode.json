{
  "name": "nextjs-project",
  "version": "1.0.0",
  "description": "Next.js project with AI agent support",
  "routing": {
    "default": "free-fast",
    "complexity": {
      "low": "free-fast",
      "medium": "free-expert",
      "high": "free-complex"
    }
  },
  "agents": {
    "path": ".opencode/agents"
  },
  "prompts": {
    "path": ".opencode/prompts"
  },
  "skills": {
    "path": ".opencode/skills"
  },
  "mcp": {
    "servers": {
      "supabase": {
        "command": "npx",
        "args": ["-y", "@supabase/mcp-server"]
      }
    }
  }
}
