{
  "name": "aidentity",
  "version": "1.0.0",
  "description": "Install AI agent skills from a verified, machine-readable registry.",
  "keywords": [
    "ai",
    "agents",
    "skills",
    "claude-code",
    "opencode",
    "codex",
    "cursor",
    "mcp"
  ],
  "homepage": "https://akshatnaruka.github.io/aidentity",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkshatNaruka/aidentity.git"
  },
  "bugs": "https://github.com/AkshatNaruka/aidentity/issues",
  "license": "MIT",
  "bin": {
    "aidentity": "cli/index.js",
    "aidentity-mcp": "cli/mcp.js"
  },
  "files": [
    "cli",
    "app",
    "registry",
    "skills",
    "bundles",
    "roles",
    "rules",
    "agents",
    "commands",
    "hooks",
    "prompts/setup",
    "README.md",
    "ROLES.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node site/build.js",
    "registry": "node scripts/build-registry.js",
    "security": "node scripts/scan-skills-security.js",
    "setup-prompts": "node scripts/build-setup-prompts.js",
    "validate": "node scripts/build-registry.js --check && node scripts/scan-skills-security.js --check && node scripts/check-licenses.js && node scripts/validate.js",
    "notices": "node scripts/generate-notices.js",
    "verify": "node scripts/verify-sources.js",
    "serve": "node site/serve.js",
    "app": "electron app/main.js",
    "app:web": "node app/server.js",
    "app:build:mac": "bash scripts/build-mac-app.sh",
    "mcp": "node cli/mcp.js",
    "recommend": "node cli/index.js recommend",
    "setup": "node cli/index.js setup",
    "audit": "node cli/index.js audit",
    "test": "node scripts/test.js",
    "prepublishOnly": "node scripts/build-registry.js --check && node scripts/scan-skills-security.js --check && node scripts/check-licenses.js && node scripts/validate.js && node scripts/test.js"
  },
  "devDependencies": {
    "electron": "^42.11.16"
  },
  "funding": [
    {
      "type": "individual",
      "url": "https://buymeacoffee.com/narukaakshat"
    },
    {
      "type": "individual",
      "url": "https://paypal.me/AkshatNaruka007"
    }
  ],
  "allowScripts": {
    "electron@33.4.11": true
  }
}
